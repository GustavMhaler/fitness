---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---

<BaseLayout>
  <main id="auth-view" class="min-h-screen px-5 py-8 sm:px-10">
    <div class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-6xl items-center">
      <div class="grid w-full gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <section class="space-y-7">
          <div class="eyebrow"><span class="pulse-dot"></span> PERSONAL TRAINING OS</div>
          <div>
            <h1 class="display-title max-w-xl">把每一次训练，<span>变成看得见的进步。</span></h1>
            <p class="mt-6 max-w-lg text-lg leading-8 text-slate-400">计划、打卡、动作趋势和目标管理集中在一个轻盈的训练工作台里。</p>
          </div>
          <div class="flex flex-wrap gap-3 text-sm text-slate-400">
            <span class="soft-chip">跨设备同步</span>
            <span class="soft-chip">深色主题</span>
            <span class="soft-chip">不伪造数据</span>
          </div>
        </section>
        <section class="glass-panel relative overflow-hidden p-6 sm:p-8">
          <div class="absolute -right-20 -top-20 h-48 w-48 rounded-full bg-cyan-400/10 blur-3xl"></div>
          <div class="relative">
            <div class="mb-8 flex items-start justify-between">
              <div>
                <p class="section-kicker">WELCOME BACK</p>
                <h2 class="mt-2 text-2xl font-semibold text-white">进入训练空间</h2>
              </div>
              <div class="icon-orb">↗</div>
            </div>
            <form id="auth-form" class="space-y-5">
              <label class="field-label" for="passcode">访问口令</label>
              <input id="passcode" name="passcode" type="password" autocomplete="current-password" required class="field-input" placeholder="输入访问口令" />
              <button class="primary-button w-full" type="submit"><span>解锁训练空间</span><span>→</span></button>
              <p id="auth-error" class="error-text min-h-5" role="alert"></p>
            </form>
            <p class="mt-7 text-xs leading-5 text-slate-500">当前设备验证后将记住 30 天。数据存储在你自己的 D1 数据库中。</p>
          </div>
        </section>
      </div>
    </div>
  </main>

  <div id="app-view" class="hidden min-h-screen lg:grid lg:grid-cols-[248px_1fr]">
    <aside class="app-sidebar border-b border-white/5 px-5 py-6 lg:min-h-screen lg:border-b-0 lg:border-r">
      <div class="flex items-center gap-3 px-2">
        <div class="brand-mark">F</div>
        <div><p class="text-sm font-semibold text-white">Fitness</p><p class="text-xs text-slate-500">Manager</p></div>
      </div>
      <nav class="mt-10 grid grid-cols-4 gap-2 lg:block lg:space-y-2" aria-label="主导航">
        <button class="nav-button is-active" data-view="plan"><span>◒</span><span>计划</span></button>
        <button class="nav-button" data-view="history"><span>↗</span><span>历史</span></button>
        <button class="nav-button" data-view="goals"><span>◎</span><span>目标</span></button>
        <button class="nav-button" data-view="settings"><span>⊙</span><span>设置</span></button>
      </nav>
      <div class="mt-auto hidden rounded-2xl border border-white/5 bg-white/[0.03] p-4 lg:block">
        <p class="section-kicker">TODAY'S NOTE</p>
        <p class="mt-3 text-sm leading-6 text-slate-400">计划是方向，记录是真实。状态不好时，允许自己降级。</p>
      </div>
    </aside>

    <section class="min-w-0 px-5 py-6 sm:px-8 lg:px-12 lg:py-10">
      <header class="mb-8 flex flex-wrap items-end justify-between gap-5">
        <div>
          <p id="date-label" class="section-kicker">TODAY</p>
          <h1 id="page-title" class="mt-2 text-3xl font-semibold tracking-tight text-white">本周计划</h1>
        </div>
        <div class="flex items-center gap-3">
          <span id="sync-status" class="sync-status"><span class="pulse-dot"></span> 已同步</span>
          <button id="logout-button" class="ghost-button" type="button">退出</button>
        </div>
      </header>

      <div id="toast" class="toast" role="status"></div>

      <section id="onboarding-view" class="hidden glass-panel p-8">
        <p class="section-kicker">FIRST SESSION</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">先把训练空间准备好</h2>
        <p class="mt-3 max-w-xl leading-7 text-slate-400">可以直接使用当前的 A/B/C 示例计划，也可以从空白开始。之后都能在设置里调整。</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <button class="primary-button" data-initialize="seed">使用示例计划 <span>→</span></button>
          <button class="secondary-button" data-initialize="blank">从空白开始</button>
        </div>
      </section>

      <div id="workspace" class="hidden">
        <section id="view-plan" class="view-panel space-y-6">
          <div id="plan-grid" class="grid gap-3 sm:grid-cols-2 xl:grid-cols-7"></div>
          <div id="today-card" class="glass-panel overflow-hidden"></div>
        </section>

        <section id="view-history" class="view-panel hidden space-y-6">
          <div id="history-summary" class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4"></div>
          <div class="glass-panel p-5 sm:p-7">
            <div class="flex flex-wrap items-end justify-between gap-4">
              <div><p class="section-kicker">PERFORMANCE</p><h2 class="mt-2 text-xl font-semibold text-white">最近训练记录</h2></div>
              <div class="flex gap-2"><input id="history-from" type="date" class="compact-input" /><input id="history-to" type="date" class="compact-input" /><button id="history-refresh" class="secondary-button" type="button">筛选</button></div>
            </div>
            <div id="history-list" class="mt-6 space-y-3"></div>
          </div>
        </section>

        <section id="view-goals" class="view-panel hidden space-y-6">
          <div class="glass-panel p-5 sm:p-7">
            <div class="flex items-end justify-between gap-4"><div><p class="section-kicker">NORTH STAR</p><h2 class="mt-2 text-xl font-semibold text-white">训练目标</h2></div><span class="soft-chip">保持具体</span></div>
            <form id="goal-form" class="mt-6 grid gap-3 sm:grid-cols-[1fr_180px_auto]"><input name="text" class="field-input" placeholder="例如：标准俯卧撑一组 ≥ 6 个" required /><input name="deadline" type="date" class="field-input" /><button class="primary-button" type="submit">添加目标</button></form>
            <div id="goal-list" class="mt-6 space-y-3"></div>
          </div>
        </section>

        <section id="view-settings" class="view-panel hidden space-y-6">
          <div class="glass-panel p-5 sm:p-7">
            <div><p class="section-kicker">CONTROL ROOM</p><h2 class="mt-2 text-xl font-semibold text-white">偏好设置</h2></div>
            <form id="settings-form" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><label class="field-label">时区<select name="timezone" class="field-input mt-2"><option>Asia/Shanghai</option><option>Asia/Tokyo</option><option>Europe/London</option><option>America/Los_Angeles</option></select></label><label class="field-label">一周开始<select name="weekStartsOn" class="field-input mt-2"><option value="1">周一</option><option value="7">周日</option></select></label><label class="field-label">默认单位<select name="defaultUnit" class="field-input mt-2"><option>kg</option><option>lb</option></select></label><label class="field-label">默认休息（秒）<input name="defaultRestDuration" class="field-input mt-2" type="number" min="0" step="15" /></label><button class="primary-button sm:col-span-2 lg:col-span-4" type="submit">保存偏好</button></form>
          </div>
          <div class="glass-panel p-5 sm:p-7"><div><p class="section-kicker">WEEKLY PLAN</p><h2 class="mt-2 text-xl font-semibold text-white">未来计划编辑</h2><p class="mt-2 text-sm text-slate-500">只影响未来日期，不改写历史。</p></div><form id="plan-form" class="mt-6 space-y-3"></form><div class="mt-5 flex flex-wrap gap-3"><button id="save-plan" class="primary-button" type="button">保存周计划 <span>→</span></button><button id="undo-plan" class="secondary-button hidden" type="button">撤销最近修改</button></div></div>
          <div class="grid gap-6 xl:grid-cols-2">
            <div class="glass-panel p-5 sm:p-7"><div><p class="section-kicker">TRAINING BLOCK</p><h2 class="mt-2 text-xl font-semibold text-white">新增训练块</h2></div><form id="block-form" class="mt-5 space-y-3"><input name="name" class="field-input mt-0" placeholder="训练块名称" required /><div class="grid gap-3 sm:grid-cols-2"><select name="category" class="field-input mt-0"><option value="custom">自定义</option><option value="push">上肢推</option><option value="pull">上肢拉</option><option value="legs">下肢</option><option value="cardio">有氧</option></select><input name="description" class="field-input mt-0" placeholder="训练块说明" /></div><button class="primary-button" type="submit">添加训练块</button></form></div>
            <div class="glass-panel p-5 sm:p-7"><div><p class="section-kicker">EXERCISE LIBRARY</p><h2 class="mt-2 text-xl font-semibold text-white">新增自定义动作</h2></div><form id="exercise-form" class="mt-5 space-y-3"><input name="name" class="field-input mt-0" placeholder="动作名称" required /><div class="grid gap-3 sm:grid-cols-2"><select name="blockId" class="field-input mt-0" id="exercise-block-select"><option value="">不归属训练块</option></select><input name="targetPart" class="field-input mt-0" placeholder="目标部位" /></div><div class="grid gap-3 sm:grid-cols-2"><input name="sets" class="field-input mt-0" type="number" min="1" placeholder="组数" /><input name="reps" class="field-input mt-0" placeholder="次数/时长" /></div><input name="note" class="field-input mt-0" placeholder="动作要点" /><button class="primary-button" type="submit">添加动作</button></form></div>
          </div>
          <div class="glass-panel p-5 sm:p-7"><div><p class="section-kicker">LIBRARY INDEX</p><h2 class="mt-2 text-xl font-semibold text-white">当前动作库</h2></div><div id="exercise-list" class="mt-5 grid gap-3 sm:grid-cols-2"></div></div>
          <div class="glass-panel p-5 sm:p-7"><div><p class="section-kicker">DATA SAFETY</p><h2 class="mt-2 text-xl font-semibold text-white">备份与恢复</h2></div><div class="mt-5 flex flex-wrap gap-3"><button id="export-json" class="secondary-button" type="button">导出 JSON</button><button id="export-csv" class="secondary-button" type="button">导出 CSV</button><label class="secondary-button cursor-pointer">导入 JSON<input id="import-json" type="file" accept="application/json" class="hidden" /></label><button id="reset-data" class="danger-button" type="button">清空数据</button></div></div>
          <div class="glass-panel p-5 sm:p-7"><div><p class="section-kicker">ACCESS</p><h2 class="mt-2 text-xl font-semibold text-white">更换访问口令</h2></div><form id="password-form" class="mt-5 grid gap-3 sm:grid-cols-3"><input name="currentPasscode" type="password" class="field-input" placeholder="当前口令" required /><input name="newPasscode" type="password" class="field-input" placeholder="新口令（至少 6 位）" required /><button class="primary-button" type="submit">更新口令</button></form></div>
        </section>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import "../scripts/app.js";
</script>
